{
  "name": "stopbill-site",
  "private": true,
  "version": "1.0.0",
  "description": "Stopbill: free guided cancellation for ChatGPT, delivered as a browser extension, plus its marketing site.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run package:extension",
    "package:extension": "node scripts/package-extension.mjs",
    "prebuild": "npm run package:extension",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "fflate": "^0.8.3",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
