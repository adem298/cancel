# Copy to .env.local for local work. Never commit real values.

# Neon Postgres connection string (requires TLS).
DATABASE_URL=

# Stripe restricted key with Checkout Sessions (write) and read access. Never a full secret key.
STRIPE_SECRET_KEY=
# Signing secret for the webhook endpoint /api/stripe-webhook.
STRIPE_WEBHOOK_SECRET=
# ID of the one-time Stripe Price for the extension (price_...).
EXTENSION_PRICE_ID=

# Public URL of the deployed site. Used for Checkout redirects.
APP_URL=https://stopbill.dev

# Signs device tokens. At least 32 random characters, for example: openssl rand -base64 48
LICENSE_TOKEN_SECRET=

# API origin built into the downloadable extension (packaging time).
EXTENSION_API_BASE=https://stopbill.dev

# Dashboard data source. Keep "demo" until the owner-side API is deployed.
VITE_API_MODE=demo
