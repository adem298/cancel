{
  "manifest_version": 3,
  "name": "Stopbill",
  "version": "0.4.0",
  "description": "Free guided ChatGPT cancellation, plus a read-only scan of AI billing receipts in Gmail.",
  "key": "",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Stopbill"
  },
  "permissions": ["storage", "identity"],
  "host_permissions": ["https://gmail.googleapis.com/*"]
}
